# --- SSI FastConnect Data API v2 ---
SSI_CONSUMER_ID=c121a33f187a4be7a189a5a0ec5dc1c6
SSI_CONSUMER_SECRET=06bf1b2ef4e449f6bf619f64c4eed969
SSI_BASE_URL=https://fc-data.ssi.com.vn/api/v2
SSI_FINANCIAL_ENDPOINT=/Market/CompanyFinancialRatio

# --- Chế độ dữ liệu ---
# USE_MOCK=true  -> luôn dùng dữ liệu mô phỏng (không gọi SSI)
# FALLBACK_TO_MOCK=true -> nếu SSI lỗi thì tự động chuyển sang mô phỏng
USE_MOCK=false
FALLBACK_TO_MOCK=true

# --- Tham số mô hình tài chính ---
RISK_FREE_RATE=0.030
EQUITY_RISK_PREMIUM=0.080
CORPORATE_TAX_RATE=0.20
TERMINAL_GROWTH=0.030
MARKET_INDEX=VNINDEX

# --- Ứng dụng ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CACHE_TTL=120
LOG_LEVEL=INFO
